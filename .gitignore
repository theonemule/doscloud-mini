# Dependencies, build/runtime state and secrets must never be published.
node_modules/
.env
.env.*
!.env.example
.DS_Store
coverage/
*.log
tmp/
.runtime/

# The persistent DOS C: drive IS a normal Git working-tree directory.
# Installed files are visible to git and can be committed/pushed explicitly.
# Temporary IPX room clones and guest overlays live outside drive/ and stay ignored.
